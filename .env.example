# SOLO PARA DESARROLLO LOCAL/EXPOSICION. Cambiar secretos en despliegues reales.
POSTGRES_PASSWORD=root
RABBITMQ_USERNAME=cocina_app
RABBITMQ_PASSWORD=root

# ── Autenticación y autorización ────────────────────────────────────────────
# Secreto compartido por ms-menu, ms-pedidos y ms-display-cocina para firmar y
# validar los JWT (HS256). Debe tener al menos 32 bytes.
JWT_SECRET=kds-dev-only-secret-change-me-please-2026
JWT_EXPIRATION_MINUTES=30

# Orígenes permitidos por CORS en los tres servicios (frontend en desarrollo).
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5174,http://localhost:5175,http://localhost:5176

# ── Bootstrap del primer ADMIN (solo ms-menu) ────────────────────────────────
# Si ADMIN_PASSWORD queda vacío no se crea ninguna cuenta al arrancar. El rol
# ADMIN no se puede asignar desde la API ni desde la interfaz: solo existe por
# este bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador KDS
