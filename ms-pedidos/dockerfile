# --- Etapa 1: Compilación interna en entorno aislado de Java 21 ---
# La imagen oficial maven:3.9.9-eclipse-temurin-21 ya incluye Maven 3.9.9 y
# JDK 21, por lo que se usa `mvn` en lugar de `./mvnw`. El wrapper descargaba
# una distribución de Maven adicional (y al no existir `unzip` en la imagen
# usaba la variante .tar.gz), lo que introducía un punto de fallo de red
# innecesario. Spring Boot 4.1.2 no impone una versión mínima de Maven
# superior a la incluida en la imagen.
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /app

# Copiar solo el POM mantiene la capa de caché de dependencias.
COPY pom.xml .
RUN mvn -B -q dependency:go-offline

# Compilar el código bajo el JDK 21 de la imagen de build
COPY src src
RUN mvn -B -q package -DskipTests

# --- Etapa 2: Entorno de ejecución seguro y ligero de producción ---
FROM eclipse-temurin:21-jre
WORKDIR /app

# Crear un usuario del sistema sin privilegios para mitigar riesgos de seguridad
RUN useradd --system --uid 1001 kds

# Copiar el ejecutable generado en la etapa anterior adaptado a tu artifactId
COPY --from=build /app/target/ms-pedidos-*.jar app.jar

# Cambiar al usuario seguro
USER kds

# Exponer el puerto oficial de ms-pedidos definido en las propiedades
EXPOSE 8082

# Comando para arrancar el microservicio
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
