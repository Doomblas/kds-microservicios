# --- Etapa 1: Compilación interna en entorno aislado de Java 21 ---
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /app

# Copiar configuraciones de dependencias y el wrapper de Maven
COPY pom.xml .
COPY .mvn .mvn
COPY mvnw .

# Descargar las dependencias en caché para acelerar futuras compilaciones
RUN ./mvnw -B -q dependency:go-offline

# Copiar tu código fuente (escrito en Java 17) para compilarlo bajo Java 21
COPY src src
RUN ./mvnw -B -q package -DskipTests

# --- Etapa 2: Entorno de ejecución seguro y ligero de producción ---
FROM eclipse-temurin:21-jre
WORKDIR /app

# Crear un usuario del sistema sin privilegios para mitigar riesgos de seguridad
RUN useradd --system --uid 1001 kds

# Copiar el ejecutable generado en la etapa anterior adaptado a tu artifactId
COPY --from=build /app/target/ms-pedidos-*.jar app.jar

# Cambiar al usuario seguro
USER kds

# Exponer el puerto oficial de ms-pedidos definido en las propiedades
EXPOSE 8082

# Comando para arrancar el microservicio
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
