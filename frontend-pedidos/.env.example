# Destinos del proxy Vite en desarrollo local.
# Con compose.integration.yaml usa 8085 (pedidos) y 8081 (menú).
VITE_PEDIDOS_API_TARGET=http://localhost:8082
VITE_MENU_API_TARGET=http://localhost:8080

# Opcional: forzar URLs absolutas (si no hay proxy / mismo origen).
# VITE_PEDIDOS_API_URL=
# VITE_MENU_API_URL=
# VITE_WS_URL=
